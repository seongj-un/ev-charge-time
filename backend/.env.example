# 이 파일을 .env로 복사해 값을 채운다. .env는 gitignore되어 커밋되지 않는다.

DATABASE_URL=postgresql+psycopg://evcharge:evcharge@localhost:5432/evcharge

# F-07 주변 충전소 (공공데이터포털)
# https://www.data.go.kr/data/15076352/openapi.do 에서 활용신청 → 개발계정 자동 승인
# 마이페이지 > 오픈API > 인증키에서 **Decoding** 키를 복사해 넣는다.
# (Encoding 키를 넣으면 이중 인코딩으로 인증이 실패한다)
CHARGER_API_KEY=

# 수집 대상 시도 코드. 기본값 12 = 전남광주통합특별시.
# 개발계정 하루 1,000건 제한이 있어 전국을 다 받으면 넘친다.
# 주의: 표준 행정구역코드의 전남(46)·광주(29)로는 0건이 나온다 — 통합되면서
# 이 API는 12를 쓴다. 강원은 51, 전북은 52다.
CHARGER_ZCODES=12

# 배포 시에만 true (HTTPS 필요)
# COOKIE_SECURE=true

# F-09 태양광 발전 예측 (공공데이터포털 "기상청_단기예보 조회서비스")
# https://www.data.go.kr/data/15084084/openapi.do 에서 활용신청
# 포털은 계정당 인증키를 하나만 주므로 CHARGER_API_KEY와 **같은 값**이 되는
# 것이 정상이다. 그래도 따로 두는 이유는 두 기능의 활용신청이 달라서 한쪽만
# 승인된 상태가 실제로 있기 때문이다. 비어 있으면 GET /api/solar-forecast는 501.
KMA_API_KEY=

# 지역별 태양광 설비용량(MW). "전남:1234.5,광주:210" 형식.
# **비어 있는 것이 기본이고, 그건 실수가 아니다.** 이 값이 없으면 응답의
# predicted_mwh가 null로 나간다 — 물리 모델이 내는 것은 단위면적당 일사량이라
# MWh로 바꾸려면 설비용량(전력거래소 자료)이 필요한데, 지금 없는 자료로
# 발전량을 지어내지 않겠다는 결정이다. 일사량(ghi_wm2)과 STC 대비 지수
# (output_index)는 설비용량과 무관하게 항상 채워진다.
SOLAR_CAPACITY_MW=

# 위 설비용량의 출처. **비어 있으면 설비용량 값 자체를 무시한다** —
# 출처를 적을 수 없는 숫자는 지어낸 숫자와 구별되지 않기 때문이다.
# 예: "전력거래소 전력통계정보시스템(EPSIS) 2026-09 기준"
SOLAR_CAPACITY_SOURCE=
