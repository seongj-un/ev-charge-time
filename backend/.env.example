# 이 파일을 .env로 복사해 값을 채운다. .env는 gitignore되어 커밋되지 않는다.

DATABASE_URL=postgresql+psycopg://evcharge:evcharge@localhost:5432/evcharge

# F-07 주변 충전소 (공공데이터포털)
# https://www.data.go.kr/data/15076352/openapi.do 에서 활용신청 → 개발계정 자동 승인
# 마이페이지 > 오픈API > 인증키에서 **Decoding** 키를 복사해 넣는다.
# (Encoding 키를 넣으면 이중 인코딩으로 인증이 실패한다)
CHARGER_API_KEY=

# 수집 대상 시도 코드. 기본값 12 = 전남광주통합특별시.
# 개발계정 하루 1,000건 제한이 있어 전국을 다 받으면 넘친다.
# 주의: 표준 행정구역코드의 전남(46)·광주(29)로는 0건이 나온다 — 통합되면서
# 이 API는 12를 쓴다. 강원은 51, 전북은 52다.
CHARGER_ZCODES=12

# 배포 시에만 true (HTTPS 필요)
# COOKIE_SECURE=true

# F-10 자연어 질의 (Google Gemini 무료 티어)
# https://aistudio.google.com/apikey 에서 "Create API key" — 신용카드 없이 발급된다.
# 비어 있으면 POST /api/chat 은 501을 반환한다 (나머지 기능은 그대로 동작).
GEMINI_API_KEY=

# 쓸 모델. 기본값은 google-genai 2.24.0이 열거한 현재 서비스 모델 표기 그대로다.
# 무료 티어에서 쓸 수 있는 모델은 바뀌므로, 거부되면(404/PERMISSION_DENIED)
# 이 값만 바꾼다. 같은 목록에 있는 후보:
#   gemini-flash-lite-latest  (항상 최신 Flash-Lite를 가리키는 별칭)
#   gemini-2.5-flash-lite     (이전 세대, 가장 오래 제공된 무료 티어 모델)
#   gemini-3.1-flash-lite     (기본값)
GEMINI_MODEL=gemini-3.1-flash-lite

# 사용자별 호출 제한 (초과 시 429). 근거는 settings.py 주석 참고.
CHAT_RATE_LIMIT_COUNT=20
CHAT_RATE_LIMIT_WINDOW_MINUTES=60
