# 배포용 값. 이 파일을 .env로 복사해 채운다. .env는 커밋되지 않는다.
#
#   cp .env.deploy.example .env
#   docker compose -f docker-compose.prod.yml up -d --build

# ── 필수 ────────────────────────────────────────────────────────────────
# 아무 긴 문자열이나. 예: openssl rand -base64 24
POSTGRES_PASSWORD=

# ── 도메인 (있으면) ─────────────────────────────────────────────────────
# 도메인을 넣으면 Caddy가 인증서를 받아 HTTPS로 서비스한다.
#   SITE_ADDRESS=kinetic.example.com
# 비워 두면 :80 으로 뜬다. 그때는 COOKIE_SECURE를 켜면 안 된다.
SITE_ADDRESS=:80

# HTTPS로 서비스할 때만 true.
# HTTP인데 true로 두면 쿠키가 아예 안 실려서 로그인이 조용히 실패한다.
COOKIE_SECURE=false

# ── 외부 키 (없으면 해당 기능만 501, 나머지는 그대로 동작) ──────────────
# 공공데이터포털은 계정당 인증키가 하나라 아래 둘이 같은 값이 되는 게 정상이다.
CHARGER_API_KEY=
KMA_API_KEY=
GEMINI_API_KEY=

# 수집 시도 코드. 12 = 전남광주통합특별시 (46·29로는 0건이 나온다).
CHARGER_ZCODES=12
